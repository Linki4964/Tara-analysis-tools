# ============================================================
# TARA Asset Identification Tool — API Configuration
# ============================================================
# Supports four providers: Anthropic (Claude), OpenAI, DeepSeek and any
# local OpenAI-compatible server (Ollama / LM Studio / vLLM).
#
# Set API_PROVIDER to one of: anthropic | openai | deepseek | local
# Leave it as 'auto' to pick the first provider that has a key configured.
#
# You can also configure everything from the Settings page in the UI, which
# takes priority over this file.

# ---- Option 1: Anthropic (Claude) ----
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---- Option 2: OpenAI ----
# NOTE: the base URL must include /v1. OpenAI's endpoint is
#       https://api.openai.com/v1/chat/completions — omitting /v1 returns 404.
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Option 3: DeepSeek ----
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Option 4: Local model (no key needed) ----
# LOCAL_MODEL=llama3
# LOCAL_BASE_URL=http://localhost:11434/v1

# ---- General ----
API_PROVIDER=auto
PORT=3000
HOST=0.0.0.0

# ---- PostgreSQL (optional) ----
# Set this to enable persistence of analysis runs.
# DATABASE_URL=<postgresql-connection-string>

# ---- Local RAG embedding model ----
RAG_EMBEDDING_MODEL=<local-bge-model-directory>
RAG_EMBEDDING_DIMENSION=512
